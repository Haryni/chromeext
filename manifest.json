{
  "manifest_version": 3,
  "name": "Exchange Rates",
  "version": "1.0",
  "description": "Extension to convert currencies quickly",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "index.html"
  },
  "host_permissions": [
    "https://api.exchangerate.host/*",
    "https://api.api-ninjas.com/*"
  ]
}
